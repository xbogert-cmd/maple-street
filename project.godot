; Maple Street — Godot 4.7.1, Forward+ renderer.

config_version=5

[application]

config/name="Maple Street"
config/description="A sleeper agent on a quiet street, 1980s."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Clock="*res://game/core/clock.gd"
Game="*res://game/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="walls (block sight and movement)"
3d_physics/layer_2="low (block movement only)"
3d_physics/layer_3="doors (block sight and movement, not in navmesh)"
3d_physics/layer_4="player"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.25

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
